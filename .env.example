# Pick one key. If both are set, GEMINI_API_KEY is used unless LLM_PROVIDER says otherwise.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# LLM_PROVIDER=gemini

# Voice (microphone + speaking) is off unless this is "true". Text chat works either way.
NEXT_PUBLIC_VOICE_ENABLED=false
