# Pick one key. If both are set, GEMINI_API_KEY is used unless LLM_PROVIDER says otherwise.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# LLM_PROVIDER=gemini

# Voice (microphone + spoken replies) is on unless this is "false".
NEXT_PUBLIC_VOICE_ENABLED=true
